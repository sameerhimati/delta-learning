node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Environment
.env
.env.local

# Build
.next/
dist/
build/
*.egg-info/
*.tsbuildinfo

# Working notes — session handoffs, demo run sheets. Not part of the project.
.internal/

