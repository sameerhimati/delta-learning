# sample comes from SAMPLE_VIDEO_URLS in .env (see data/videos/ATTRIBUTION.md).
data/videos/*.mp4

# Sample data for the starter's agent-memory domain, which this project doesn't use.
data/fixtures.json

# agent scratch scripts
frontend/_*.mjs
frontend/app/_*/

# yt-dlp auth for the URL-ingest path — session cookies, never commit
cookies.txt
*.cookies
